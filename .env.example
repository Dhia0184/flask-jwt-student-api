# Copy this file to ".env" and fill in real values.
# ".env" is ignored by git. This template is safe to commit: it has no real secrets.

# Secret used to sign login tokens (required).
# Generate one with:

# Database (optional). If left unset, the app uses a local SQLite file.
# DATABASE_URL=sqlite:///students.db

# Set to 1 only while developing, never in production.
# FLASK_DEBUG=1
KEYCLOAK_ISSUER=http://localhost:8080/realms/university-api
KEYCLOAK_AUDIENCE=university-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/university-api/protocol/openid-connect/certs